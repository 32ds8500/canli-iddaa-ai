# ============================================================
# Canli Iddaa AI - Ornek ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayip gercek degerleri girin.
# API anahtarlari YALNIZCA sunucu tarafinda tutulur ve
# hicbir zaman frontend'e gonderilmez.
# ============================================================

# API-Football (api-sports.io) - birincil saglayici (ZORUNLU)
# Ucretsiz plan: 100 istek/gun, 10 istek/dakika
# Kayit: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# RapidAPI uzerinden API-Football (alternatif kimlik dogrulama)
# API_FOOTBALL_KEY bos ise bu kullanilir. Ucretsiz plan icin:
# https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# API-Football temel adres (genelde degistirmeye gerek yok)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# football-data.org - yedek/ikincil saglayici (opsiyonel)
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Veritabani (yerel gelistirme icin SQLite)
DATABASE_URL=sqlite:///./data/app.db

# Kota yonetimi
DAILY_QUOTA=100
PER_MINUTE_QUOTA=10
# Kota koruma payi: gunluk kotanin son bu kadari canli tahmin icin ayrilir
QUOTA_RESERVE=15

# Onbellek ve yenileme
LIVE_CACHE_TTL_SECONDS=60
STATS_CACHE_TTL_SECONDS=45
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3

# Zamanlanmis gorevler
LIVE_POLL_INTERVAL_SECONDS=180
OUTCOME_SETTLE_INTERVAL_SECONDS=300
